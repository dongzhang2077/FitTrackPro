#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

if [[ "${SKIP_PRE_PUSH_CHECKS:-0}" == "1" ]]; then
  echo "SKIP_PRE_PUSH_CHECKS=1 set. Skipping pre-push checks."
  exit 0
fi

echo "Running pre-push checks..."
./scripts/ci-check.sh
echo "Pre-push checks passed."
